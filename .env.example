# LLM Provider Configuration (one of OPENAI_API_KEY or GEMINI_API_KEY is required for live briefs/rewrites)
# Deterministic writing checks and metrics work offline without any key.

# Option A: OpenAI
OPENAI_API_KEY=
# Optional OpenAI configuration:
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Option B: Google Gemini (uses Gemini OpenAI-compatible endpoint)
# GEMINI_API_KEY=
# Optional Gemini configuration:
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

